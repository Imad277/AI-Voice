# VoiceOS Phase 0 – example configuration. Copy to `.env` (git-ignored) and fill in
# local-only values. Never commit real secrets. No provider credentials exist in Phase 0.

# Phase 0 safety switches. Any value other than "false" is refused at startup.
VOICEOS_LIVE_ENABLED=false
VOICEOS_RECORDING_ENABLED=false

# Local Docker Compose PostgreSQL (bound to 127.0.0.1 only).
VOICEOS_PG_HOST=127.0.0.1
VOICEOS_PG_PORT=55432
VOICEOS_PG_DB=voiceos

# Local-only passwords for the throwaway dev container. Generate your own, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
VOICEOS_MIGRATOR_PASSWORD=
VOICEOS_APP_PASSWORD=

# Phase 1 local LiveKit transport gate only (docker-compose.livekit.yml, --dev mode).
# These are LiveKit's public dev-mode placeholders, not secrets. Loopback URLs only.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Phase 1 STT baseline gate only (Deepgram). Put the real key ONLY into the git-ignored .env.
DEEPGRAM_API_KEY=

# Phase 1 LLM baseline gate only (OpenAI). Put the real key ONLY into the git-ignored .env.
OPENAI_API_KEY=

# Phase 1 TTS baseline gate only (ElevenLabs). Put the real key ONLY into the git-ignored .env.
ELEVENLABS_API_KEY=

# Phase 1 TTS challenger gate only (Cartesia). Put the real key ONLY into the git-ignored .env.
CARTESIA_API_KEY=
